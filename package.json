{
  "name": "playwright-bdd-js",
  "version": "1.0.0",
  "description": "Playwright with Cucumber BDD Framework - Registration Form Class Six",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:smoke": "cucumber-js --tags '@smoke' --config cucumber.js",
    "test:regression": "cucumber-js --tags '@regression' --config cucumber.js",
    "test:registration": "cucumber-js --tags '@registration' --config cucumber.js",
    "test:positive": "cucumber-js --tags '@positive' --config cucumber.js",
    "test:negative": "cucumber-js --tags '@negative' --config cucumber.js",
    "test:headless": "HEADLESS=true cucumber-js --config cucumber.js",
    "test:chrome": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "setup": "node scripts/setup.js",
    "verify": "node scripts/verify-setup.js",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:professional": "node scripts/generate-professional-report.js",
    "report:open": "open reports/html/index.html",
    "clean": "rm -rf reports/ screenshots/ videos/ test-results/",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "docker:build": "docker build -t playwright-bdd .",
    "docker:run": "docker run --rm -v $(pwd)/reports:/app/reports playwright-bdd"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "automation",
    "testing",
    "e2e",
    "registration",
    "class-six"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.0",
    "@cucumber/html-formatter": "^20.4.0",
    "@cucumber/pretty-formatter": "^4.0.1",
    "@faker-js/faker": "^8.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.10.0",
    "allure-commandline": "^2.27.0",
    "allure-cucumberjs": "^3.11.0",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "cucumber-html-reporter": "^5.0.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "fs-extra": "^11.2.0",
    "multiple-cucumber-html-reporter": "^3.0.1",
    "open": "^10.0.3",
    "prettier": "^3.1.0",
    "winston": "^3.11.0"
  }
}